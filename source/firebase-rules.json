{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (root.child('admin/maint/on').val() != true || (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true))"
      }
    },
    "stats": {
      ".read": true,
      ".write": "auth != null"
    },
    "online": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "unames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid)"
      }
    },
    "lb": {
      ".read": true,
      "$week": {
        "$board": {
          ".indexOn": [
            "v"
          ],
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$f": {
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $f)"
        }
      }
    },
    "freq": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$f": {
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $f)"
        }
      }
    },
    "ftask": {
      "$pair": {
        ".read": "auth != null && $pair.contains(auth.uid)",
        "$week": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "clans": {
      ".read": "auth != null",
      ".indexOn": [
        "open"
      ],
      "$cid": {
        ".write": "auth != null && (!data.exists() || data.child('owner').val() == auth.uid)",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "clanNames": {
      ".read": "auth != null",
      "$n": {
        ".write": "auth != null"
      }
    },
    "clanCodes": {
      ".read": "auth != null",
      "$c": {
        ".write": "auth != null"
      }
    },
    "clanOf": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "clanChat": {
      "$cid": {
        ".read": "auth != null && root.child('clans/' + $cid + '/members/' + auth.uid).exists()",
        ".write": "auth != null && root.child('clans/' + $cid + '/owner').val() == auth.uid",
        "$m": {
          ".write": "auth != null && root.child('clans/' + $cid + '/members/' + auth.uid).exists()"
        }
      }
    },
    "trades": {
      "$tid": {
        ".read": "auth != null && (!data.exists() || data.child('a').val() == auth.uid || data.child('b').val() == auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('a').val() == auth.uid) || data.child('a').val() == auth.uid || data.child('b').val() == auth.uid)"
      }
    },
    "tradeInv": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$tid": {
          ".write": "auth != null"
        }
      }
    },
    "codes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2'"
      }
    },
    "packs": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$pid": {
          ".write": "auth != null && auth.uid == $uid && !data.exists()"
        }
      }
    },
    "admins": {
      ".read": false,
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "admin": {
      "announce": {
        ".read": true,
        ".indexOn": [
          "start"
        ],
        "$id": {
          ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)",
          ".validate": "newData.hasChildren(['title','msg','type','end'])"
        }
      },
      "maint": {
        ".read": true,
        ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)",
        ".validate": "newData.hasChildren(['on'])"
      },
      "reset": {
        ".read": true,
        ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)",
        ".validate": "newData.hasChildren(['state','at'])"
      },
      "update": {
        ".read": true,
        ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)",
        ".validate": "newData.hasChildren(['version'])"
      },
      "log": {
        ".read": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)",
        "$id": {
          ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true) && !data.exists()"
        }
      },
      "gifts": {
        ".read": true,
        ".indexOn": [
          "start"
        ],
        "$id": {
          ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)",
          ".validate": "newData.hasChildren(['title','items','start','end'])"
        }
      },
      "movie": {
        ".read": true,
        ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)",
        ".validate": "!newData.exists() || newData.hasChildren(['start','end'])"
      },
      "menuMusic": {
        ".read": true,
        ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)",
        ".validate": "!newData.exists() || newData.hasChildren(['src'])"
      },
      "flags": {
        ".read": true,
        ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)"
      },
      "periods": {
        ".read": true,
        ".write": "auth != null && (auth.uid == 'Zde9C8Lc8selsvCUmmFn1bwTG0m2' || root.child('admins/' + auth.uid).val() == true)",
        "$k": {
          ".validate": "!newData.exists() || newData.hasChildren(['start','end'])"
        }
      }
    },
    "replays": {
      "$week": {
        "$board": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.child('d').isString() && newData.child('d').val().length < 300000"
          }
        }
      }
    },
    "dm": {
      "$pair": {
        ".read": "auth != null && $pair.contains(auth.uid)",
        "$m": {
          ".write": "auth != null && $pair.contains(auth.uid) && !data.exists() && newData.child('u').val() == auth.uid",
          ".validate": "newData.hasChildren(['u','m','t']) && newData.child('m').isString() && newData.child('m').val().length <= 160"
        }
      }
    },
    "fgift": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$gid": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() == auth.uid && root.child('friends/' + $uid + '/' + auth.uid).exists()) || (auth.uid == $uid && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['from','k','id','t']) && newData.child('k').isString() && newData.child('id').isString() && newData.child('id').val().length < 40)"
        }
      }
    }
  }
}